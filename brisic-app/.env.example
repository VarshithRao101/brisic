# ---- Brisic environment ----
# Copy to .env (database) and .env.local (everything else) and fill in real values.

# --- Database (Neon Postgres) — put these in .env ---
# Local dev: the DIRECT connection (faster from far away).
# Vercel: the POOLED connection (host contains "-pooler", add &pgbouncer=true).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Direct (non-pooled) connection, used for migrations:
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# --- Auth.js — put these in .env.local ---
# Generate with:  npx auth secret
AUTH_SECRET="replace-me"
# Google Cloud Console → Google Auth Platform → Clients → Web client
# Redirect URI (local): http://localhost:3000/api/auth/callback/google
# Redirect URI (prod):  https://YOUR-DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Music catalog ---
# Default: Brisic's own catalog (creator uploads + sample content). "globaltune" switches to that adapter.
CATALOG_PROVIDER="brisic"
GLOBAL_TUNE_API_URL=""
GLOBAL_TUNE_API_KEY=""

# --- Get-the-app page ---
# Link to the hosted Android .apk. Leave empty until the APK exists.
NEXT_PUBLIC_APK_URL=""

# --- Email (password reset) ---
# From https://resend.com. EMAIL_FROM must use a domain verified in Resend.
# Without these, "Forgot password?" is hidden in production (in dev the email is printed to the console).
RESEND_API_KEY=""
EMAIL_FROM="Brisic <noreply@your-domain.com>"

# --- Netlify only ---
# Pins sign-in to the main address (otherwise Google sees per-deploy URLs).
AUTH_URL="https://brisic.netlify.app"
AUTH_TRUST_HOST="true"

# --- Creators (invite-only) ---
# Emails of Brisic admins, comma separated. Admins open /admin to invite artists and podcasters.
ADMIN_EMAILS="you@example.com"

# --- File storage: Neon Object Storage (songs, covers, artist photos, podcast audio) ---
# Neon Console → Brisic project → branch "production" → Object storage → New bucket "brisic-media" (private).
# Then Connect → Storage → Parameters only. Netlify reserves AWS_* names, so use these names instead:
NEON_S3_ENDPOINT=""
NEON_S3_REGION="us-east-1"
NEON_S3_ACCESS_KEY_ID=""
NEON_S3_SECRET_ACCESS_KEY=""
NEON_S3_BUCKET="brisic-media"
# Without these, local development keeps files in ./.media and production turns song uploads off.

# --- YouTube direct upload (optional; videos go to Brisic's channel as unlisted) ---
# Until these are set, creators paste YouTube links (videos and lives), which already play inside Brisic.
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
YOUTUBE_REFRESH_TOKEN=""
