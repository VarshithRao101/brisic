# ---- Brisic environment ----
# Copy to .env (database) and .env.local (everything else) and fill in real values.

# --- Database (Neon Postgres) — put these in .env ---
# Local dev: the DIRECT connection (faster from far away).
# Vercel: the POOLED connection (host contains "-pooler", add &pgbouncer=true).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Direct (non-pooled) connection, used for migrations:
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# --- Auth.js — put these in .env.local ---
# Generate with:  npx auth secret
AUTH_SECRET="replace-me"
# Google Cloud Console → Google Auth Platform → Clients → Web client
# Redirect URI (local): http://localhost:3000/api/auth/callback/google
# Redirect URI (prod):  https://YOUR-DOMAIN/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Music catalog ---
# "mock" (sample data, default) or "globaltune" once src/lib/catalog/globaltune.ts is filled in.
CATALOG_PROVIDER="mock"
GLOBAL_TUNE_API_URL=""
GLOBAL_TUNE_API_KEY=""

# --- Get-the-app page ---
# Link to the hosted Android .apk. Leave empty until the APK exists.
NEXT_PUBLIC_APK_URL=""
