// Brisic — production schema
// Auth.js (NextAuth) models + Brisic user data.
// Track/artist rows store a small snapshot (title, artist) of catalog items,
// so the library renders without calling the music API.

generator client {
  provider = "prisma-client-js"
  // "native" for local dev; rhel-openssl-3.0.x for Netlify/AWS Lambda (Amazon Linux 2023).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Brisic-specific
  username      String?   @unique
  passwordHash  String?
  bio           String?
  coins         Int       @default(0)
  isPremium     Boolean   @default(false)
  settings      Json?

  accounts      Account[]
  sessions      Session[]
  likes         LikedTrack[]
  playlists     UserPlaylist[]
  follows       Follow[]
  history       PlayHistory[]
  coinLedger    CoinTransaction[]
  gifts         Gift[]
  unlocks       Unlock[]
  notifications Notification[]
  resetTokens   PasswordResetToken[]
  avatar        Avatar?
  partyRooms    PartyRoom[]
  partyMembers  PartyMember[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LikedTrack {
  id          String   @id @default(cuid())
  userId      String
  trackId     String
  title       String
  artistId    String
  artistName  String
  durationSec Int
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId, createdAt])
}

model UserPlaylist {
  id        String          @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks    PlaylistTrack[]

  @@index([userId, updatedAt])
}

model PlaylistTrack {
  id          String       @id @default(cuid())
  playlistId  String
  trackId     String
  title       String
  artistId    String
  artistName  String
  durationSec Int
  addedAt     DateTime     @default(now())
  playlist    UserPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
}

model Follow {
  id         String   @id @default(cuid())
  userId     String
  artistId   String
  artistName String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, artistId])
}

model PlayHistory {
  id          String   @id @default(cuid())
  userId      String
  trackId     String
  title       String
  artistId    String
  artistName  String
  durationSec Int
  playedAt    DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, playedAt])
}

model CoinTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int // positive = added, negative = spent
  kind      String // BONUS | GIFT | UNLOCK | PURCHASE
  note      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Gift {
  id         String   @id @default(cuid())
  userId     String
  artistId   String
  artistName String
  giftId     String
  giftName   String
  quantity   Int
  coins      Int
  message    String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([artistId, createdAt])
}

model Unlock {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, read])
}

/// Fixed-window rate limits (login, sign-up, coin actions, password reset).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// One-time password reset links. Only a SHA-256 hash of the token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Uploaded profile photo (resized to 256px in the browser, about 20-40 KB).
model Avatar {
  userId    String   @id
  mime      String
  data      Bytes
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Community Party (listening rooms) ----------

model PartyRoom {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  hostId      String
  isPublic    Boolean   @default(true)
  chatOpen    Boolean   @default(true)
  nowItemId   String?
  nowStarted  DateTime?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  host        User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  members     PartyMember[]
  queue       PartyQueueItem[]
  messages    PartyMessage[]

  @@index([isPublic, endedAt, updatedAt])
  @@index([hostId])
}

model PartyMember {
  id       String    @id @default(cuid())
  roomId   String
  userId   String
  joinedAt DateTime  @default(now())
  lastSeen DateTime  @default(now())
  room     PartyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model PartyQueueItem {
  id          String    @id @default(cuid())
  roomId      String
  trackId     String
  title       String
  artistName  String
  durationSec Int
  addedById   String
  addedByName String
  votes       Int       @default(0)
  playedAt    DateTime?
  createdAt   DateTime  @default(now())
  room        PartyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  voters      PartyVote[]

  @@index([roomId, playedAt])
}

model PartyVote {
  itemId String
  userId String
  item   PartyQueueItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, userId])
}

model PartyMessage {
  id        String    @id @default(cuid())
  roomId    String
  userId    String
  userName  String
  text      String
  createdAt DateTime  @default(now())
  room      PartyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}
