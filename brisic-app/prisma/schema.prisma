// Brisic — production schema
// Auth.js (NextAuth) models + Brisic user data.
// Track/artist rows store a small snapshot (title, artist) of catalog items,
// so the library renders without calling the music API.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; rhel-openssl-3.0.x for Netlify/AWS Lambda (Amazon Linux 2023).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Brisic-specific
  username     String?   @unique
  passwordHash String?
  bio          String?
  coins        Int       @default(0)
  isPremium    Boolean   @default(false)
  // Paid Premium runs until this date (null = no paid Premium).
  premiumUntil DateTime?
  // Invite-only creators: "artist" or "podcaster" (granted by an admin), null for listeners.
  creatorRole  String?
  settings     Json?

  accounts      Account[]
  sessions      Session[]
  likes         LikedTrack[]
  playlists     UserPlaylist[]
  follows       Follow[]
  history       PlayHistory[]
  payments      Payment[]
  coinLedger    CoinTransaction[]
  gifts         Gift[]
  unlocks       Unlock[]
  notifications Notification[]
  resetTokens   PasswordResetToken[]
  avatar        Avatar?
  partyRooms    PartyRoom[]
  partyMembers  PartyMember[]
  artistProfile ArtistProfile?
  podcastShows  PodcastShow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LikedTrack {
  id          String   @id @default(cuid())
  userId      String
  trackId     String
  title       String
  artistId    String
  artistName  String
  durationSec Int
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId, createdAt])
}

model UserPlaylist {
  id        String          @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks    PlaylistTrack[]

  @@index([userId, updatedAt])
}

model PlaylistTrack {
  id          String       @id @default(cuid())
  playlistId  String
  trackId     String
  title       String
  artistId    String
  artistName  String
  durationSec Int
  addedAt     DateTime     @default(now())
  playlist    UserPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
}

model Follow {
  id         String   @id @default(cuid())
  userId     String
  artistId   String
  artistName String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, artistId])
}

model PlayHistory {
  id          String   @id @default(cuid())
  userId      String
  trackId     String
  title       String
  artistId    String
  artistName  String
  durationSec Int
  playedAt    DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, playedAt])
  @@index([artistId, playedAt])
}

model CoinTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int // positive = added, negative = spent
  kind      String // BONUS | GIFT | UNLOCK | PURCHASE
  note      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Gift {
  id         String   @id @default(cuid())
  userId     String
  artistId   String
  artistName String
  giftId     String
  giftName   String
  quantity   Int
  coins      Int
  message    String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([artistId, createdAt])
}

model Unlock {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, read])
}

/// Fixed-window rate limits (login, sign-up, coin actions, password reset).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// One-time password reset links. Only a SHA-256 hash of the token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Uploaded profile photo (resized to 256px in the browser, about 20-40 KB).
model Avatar {
  userId    String   @id
  mime      String
  data      Bytes
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Community Party (listening rooms) ----------

model PartyRoom {
  id         String           @id @default(cuid())
  code       String           @unique
  name       String
  // Null for an artist community room, which no listener hosts.
  hostId     String?
  // Set for an artist's official community room (one per artist).
  artistId   String?          @unique
  // Set for Brisic's always-open featured rooms on Home ("Join a Party"), e.g. "friday-night-vibes".
  featureKey String?          @unique
  isPublic   Boolean          @default(true)
  chatOpen   Boolean          @default(true)
  nowItemId  String?
  nowStarted DateTime?
  endedAt    DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  host       User?            @relation(fields: [hostId], references: [id], onDelete: Cascade)
  members    PartyMember[]
  queue      PartyQueueItem[]
  messages   PartyMessage[]

  @@index([isPublic, endedAt, updatedAt])
  @@index([hostId])
}

model PartyMember {
  id       String    @id @default(cuid())
  roomId   String
  userId   String
  joinedAt DateTime  @default(now())
  lastSeen DateTime  @default(now())
  room     PartyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model PartyQueueItem {
  id          String      @id @default(cuid())
  roomId      String
  trackId     String
  title       String
  artistName  String
  durationSec Int
  addedById   String
  addedByName String
  votes       Int         @default(0)
  playedAt    DateTime?
  createdAt   DateTime    @default(now())
  room        PartyRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  voters      PartyVote[]

  @@index([roomId, playedAt])
}

model PartyVote {
  itemId String
  userId String
  item   PartyQueueItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([itemId, userId])
}

model PartyMessage {
  id        String    @id @default(cuid())
  roomId    String
  userId    String
  userName  String
  text      String
  createdAt DateTime  @default(now())
  room      PartyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

// ---------- Brisic catalog: creators, songs, videos, podcasts ----------

/**
 * A creator's public artist page. id is the URL slug, e.g. "ama-joy".
 */
model ArtistProfile {
  id         String      @id
  userId     String      @unique
  name       String
  genre      String
  bio        String      @default("")
  imageKey   String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  songs      Song[]
  videos     Video[]
  exclusives Exclusive[]
  merch      MerchItem[]
}

/**
 * An uploaded song. Files live in object storage; rows keep the keys.
 */
model Song {
  id          String                  @id @default(cuid())
  artistId    String
  title       String
  albumTitle  String?
  durationSec Int
  audioKey    String
  audioType   String
  coverKey    String?
  explicit    Boolean                 @default(false)
  plays       Int                     @default(0)
  // Lyrics as plain text; a line like [Chorus] starts a section.
  lyrics      String?
  createdAt   DateTime                @default(now())
  artist      ArtistProfile           @relation(fields: [artistId], references: [id], onDelete: Cascade)
  playlists   EditorialPlaylistSong[]

  @@index([artistId, createdAt])
  @@index([createdAt])
}

/**
 * Artist Spotlight videos and lives, played from YouTube inside Brisic.
 */
model Video {
  id          String        @id @default(cuid())
  artistId    String
  title       String
  kind        String
  youtubeId   String
  isLive      Boolean       @default(false)
  blurb       String        @default("")
  durationSec Int           @default(0)
  views       Int           @default(0)
  createdAt   DateTime      @default(now())
  artist      ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([artistId, createdAt])
}

/**
 * A podcaster's show. id is the URL slug.
 */
model PodcastShow {
  id        String           @id
  userId    String
  title     String
  host      String
  blurb     String           @default("")
  about     String           @default("")
  colorFrom String           @default("#7a2a8a")
  colorTo   String           @default("#2a0f45")
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  episodes  PodcastEpisode[]

  @@index([userId])
}

/**
 * An episode: a YouTube video (or live), an uploaded audio file, or both.
 */
model PodcastEpisode {
  id          String      @id @default(cuid())
  showId      String
  number      Int
  title       String
  description String      @default("")
  minutes     Int         @default(0)
  youtubeId   String?
  audioKey    String?
  audioType   String?
  isLive      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  show        PodcastShow @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@unique([showId, number])
}

// Paystack checkouts (B-Coin bundles). Coins are added once, when Paystack confirms the payment.
model Payment {
  id         String    @id @default(cuid())
  reference  String    @unique
  userId     String
  kind       String // COINS | PREMIUM
  months     Int       @default(0) // Premium months bought
  coins      Int
  amountKobo Int
  status     String    @default("pending") // pending | success | failed
  channel    String?
  createdAt  DateTime  @default(now())
  paidAt     DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Brisic's own playlists, made by admins and shown on Home in named shelves.
model EditorialPlaylist {
  id        String                  @id // "pl-<slug>"
  title     String
  subtitle  String                  @default("")
  shelf     String // Home shelf title, e.g. "Love Songs"
  artFrom   String                  @default("#2f7a34")
  artTo     String                  @default("#10381a")
  hero      String? // design artwork variant for the playlist page, e.g. "x17"
  position  Int                     @default(0)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  songs     EditorialPlaylistSong[]

  @@index([shelf, position])
}

model EditorialPlaylistSong {
  playlistId String
  songId     String
  position   Int
  addedAt    DateTime          @default(now())
  playlist   EditorialPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song       Song              @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([playlistId, songId])
  @@index([playlistId, position])
}

// Fan-only content an artist sells for B-Coins: a YouTube video (unlisted) and/or an audio file.
model Exclusive {
  id          String        @id @default(cuid())
  artistId    String
  title       String
  description String        @default("")
  kind        String // Song | Video | Story
  price       Int
  youtubeId   String?
  audioKey    String?
  audioType   String?
  createdAt   DateTime      @default(now())
  artist      ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId, createdAt])
}

// Artist merch. Fans buy through the artist's own store link until Brisic checkout ships.
model MerchItem {
  id          String        @id @default(cuid())
  artistId    String
  name        String
  priceNaira  Int
  description String        @default("")
  imageKey    String?
  buyUrl      String?
  createdAt   DateTime      @default(now())
  artist      ArtistProfile @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@index([artistId, createdAt])
}
